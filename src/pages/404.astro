---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Divider from '../components/Divider.astro';
---
<Base title="Not found" description="This page could not be found.">
  <section class="notfound">
    <p class="eyebrow--mono">Error 404</p>
    <h1 class="h1">This path leads nowhere.</h1>
    <p class="body notfound__body">The page you were looking for has moved, or never existed. The workshop is still here.</p>
    <Divider class="notfound__divider" />
    <div class="notfound__actions">
      <Button href="/" variant="primary">Return home</Button>
      <Button href="/capsules" variant="secondary">See the capsules</Button>
    </div>
  </section>
</Base>

<style>
  .notfound {
    max-width: 46ch;
    margin: 0 auto;
    padding: 140px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .notfound .eyebrow--mono { margin-bottom: 20px; }
  .notfound__body { margin: 22px 0 0; }
  .notfound__divider { margin: 40px auto; }
  .notfound__actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
</style>
