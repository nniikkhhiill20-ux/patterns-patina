---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { pieces } from '../data/content';

const steps = [
  { n: '01', title: 'Conversation', body: 'We talk through the form, the room and the feeling. No obligation, no deposit.' },
  { n: '02', title: 'Drawing', body: 'You receive a drawing with timber and pattern options, and a firm price.' },
  { n: '03', title: 'Making', body: 'The piece is cut, carved and finished by hand in Nairobi over the lead time.' },
  { n: '04', title: 'Delivery', body: 'It is wrapped, shipped and, where we can, placed in the room ourselves.' },
];
---
<Base title="Commissions" description="How a commission works, and the enquiry form. Made for one house.">
  <!-- Hero -->
  <section class="section page-pad comm-hero">
    <p class="eyebrow">Commissions</p>
    <h1 class="h1">Made for one house</h1>
    <p class="body comm-hero__lead">
      Private &amp; project commissions by enquiry. A commission begins with a conversation and ends with one piece, made for your rooms. For pieces from Elsewhere, ready to own now, see the capsule or WhatsApp +254 769 154 883.
    </p>
  </section>

  <!-- Process -->
  <section class="page-pad comm-process">
    <div class="comm-process__grid">
      {steps.map((s) => (
        <div class="comm-step reveal">
          <span class="comm-step__n">{s.n}</span>
          <h2 class="comm-step__title">{s.title}</h2>
          <p class="comm-step__body">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Enquiry form -->
  <section class="section page-pad comm-form-wrap">
    <div class="comm-form-inner">
      <header class="comm-form-head">
        <p class="eyebrow">Enquiry</p>
        <h2 class="h2">Write to the workshop</h2>
      </header>

      <form class="enquiry" id="enquiryForm" novalidate>
        <div class="field" data-field="name">
          <label class="field__label" for="f-name">Name</label>
          <input class="field__input" id="f-name" name="name" type="text" autocomplete="name" required />
          <span class="field__error">Please tell us your name.</span>
        </div>

        <div class="field" data-field="email">
          <label class="field__label" for="f-email">Email</label>
          <input class="field__input" id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required />
          <span class="field__error">Please enter a valid email.</span>
        </div>

        <div class="field" data-field="location">
          <label class="field__label" for="f-location">Location</label>
          <input class="field__input" id="f-location" name="location" type="text" autocomplete="address-level2" />
          <span class="field__error"></span>
        </div>

        <div class="field" data-field="piece">
          <label class="field__label" for="f-piece">Piece or form of interest</label>
          <select class="field__select" id="f-piece" name="piece">
            <option value="">No particular piece yet</option>
            {pieces.map((p) => (<option value={p.slug}>{p.name}</option>))}
          </select>
          <span class="field__error"></span>
        </div>

        <div class="field" data-field="pattern">
          <label class="field__label" for="f-pattern">Pattern preference</label>
          <input class="field__input" id="f-pattern" name="pattern" type="text" placeholder="Ikat, floral tapestry, toile…" />
          <span class="field__error"></span>
        </div>

        <div class="field" data-field="timing">
          <label class="field__label" for="f-timing">Timing</label>
          <select class="field__select" id="f-timing" name="timing">
            <option value="within-3-months">Within 3 months</option>
            <option value="3-6-months">3 – 6 months</option>
            <option value="exploring">Just exploring</option>
          </select>
          <span class="field__error"></span>
        </div>

        <div class="field" data-field="message">
          <label class="field__label" for="f-message">Message</label>
          <textarea class="field__textarea" id="f-message" name="message" rows="5" required></textarea>
          <span class="field__error">A line or two about what you have in mind.</span>
        </div>

        <button type="submit" class="btn btn--primary enquiry__submit">Send enquiry</button>
        <p class="enquiry__form-error" data-form-error hidden>Something went wrong sending that. Please try again, or write to us directly.</p>
      </form>

      <div class="enquiry-sent" id="enquirySent" hidden>
        <span class="enquiry-sent__plus">+</span>
        <p class="enquiry-sent__msg">Thank you. We will write back within two working days.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .comm-hero { padding-bottom: 40px; }
  .comm-hero .eyebrow { margin-bottom: 14px; }
  .comm-hero__lead { margin-top: 22px; max-width: 46ch; }

  .comm-process { padding-bottom: 24px; }
  .comm-process__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 40px 32px;
  }
  .comm-step__n {
    font-family: var(--mono); font-size: 11px; color: var(--crest-gold);
    letter-spacing: .1em;
  }
  .comm-step__title {
    font-family: var(--serif); font-weight: 300; font-size: 22px;
    color: var(--ink); margin: 12px 0 8px;
  }
  .comm-step__body {
    font-family: var(--sans); font-weight: 300; font-size: 14.5px;
    line-height: 1.7; color: var(--ink-soft); max-width: 28ch;
  }

  .comm-form-wrap { background: var(--paper-deep); }
  .comm-form-inner { max-width: 560px; margin: 0 auto; }
  .comm-form-head { text-align: center; margin-bottom: 40px; }
  .comm-form-head .eyebrow { display: block; margin-bottom: 12px; }

  .enquiry { display: flex; flex-direction: column; gap: 22px; }
  .enquiry__submit { align-self: flex-start; margin-top: 6px; }
  .enquiry__form-error { color: var(--error); font-size: 13px; }

  .enquiry-sent {
    text-align: center;
    padding: 60px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    animation: fade-in 500ms ease-out both;
  }
  .enquiry-sent__plus {
    font-family: var(--serif); font-weight: 300; color: var(--crest-gold);
    font-size: 48px; line-height: 1;
  }
  .enquiry-sent__msg {
    font-family: var(--serif); font-weight: 300; font-size: 24px;
    color: var(--olive-story); max-width: 24ch;
  }
</style>

<script>
  const form = document.getElementById('enquiryForm') as HTMLFormElement | null;
  const sent = document.getElementById('enquirySent');
  const formError = form?.querySelector('[data-form-error]') as HTMLElement | null;
  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  // Pre-fill piece from ?piece=slug
  const params = new URLSearchParams(window.location.search);
  const piece = params.get('piece');
  if (piece) {
    const select = document.getElementById('f-piece') as HTMLSelectElement | null;
    if (select && [...select.options].some((o) => o.value === piece)) select.value = piece;
  }

  const setError = (name: string, on: boolean) => {
    const field = form?.querySelector(`[data-field="${name}"]`);
    field?.classList.toggle('field--error', on);
  };

  const validate = () => {
    if (!form) return false;
    let ok = true;
    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();
    const nameOk = name.length > 0; setError('name', !nameOk); ok = ok && nameOk;
    const emailOk = emailRe.test(email); setError('email', !emailOk); ok = ok && emailOk;
    const msgOk = message.length > 0; setError('message', !msgOk); ok = ok && msgOk;
    return ok;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (formError) formError.hidden = true;
    if (!validate()) {
      form.querySelector('.field--error input, .field--error textarea')
        ?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    const submit = form.querySelector('.enquiry__submit') as HTMLButtonElement;
    submit.disabled = true;
    submit.textContent = 'Sending…';

    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch('/api/enquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kind: 'enquiry', ...data }),
      });
      if (!res.ok) throw new Error('bad status');
      form.hidden = true;
      if (sent) sent.hidden = false;
      sent?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (_) {
      submit.disabled = false;
      submit.textContent = 'Send enquiry';
      if (formError) formError.hidden = false;
    }
  });

  // Clear a field's error as the visitor corrects it
  ['name', 'email', 'message'].forEach((n) => {
    form?.querySelector(`[name="${n}"]`)?.addEventListener('input', () => setError(n, false));
  });
</script>
