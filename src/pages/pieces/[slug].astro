---
export const prerender = true;
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import ProductCard from '../../components/ProductCard.astro';
import {
  pieces,
  pieceBySlug,
  capsuleBySlug,
  otherPiecesInCapsule,
} from '../../data/content';

export function getStaticPaths() {
  return pieces.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const piece = pieceBySlug(slug!)!;
const capsule = capsuleBySlug(piece.capsule)!;
const others = otherPiecesInCapsule(piece.capsule, piece.slug);

const details: Array<[string, string]> = [
  ['Form', piece.form],
  ['Timber', piece.timber],
  ['Pattern', piece.pattern],
  ['Dimensions', piece.dimensions],
  ['Finish', piece.finish],
  ['Made in', piece.madeIn],
];
---
<Base title={piece.name} description={piece.description[0]}>
  <div class="piece page-pad">
    <!-- Gallery -->
    <div class="piece__gallery">
      <div class="frame">
        <Image
          src={piece.hero.src}
          alt={piece.hero.alt}
          widths={[480, 768, 1100]}
          sizes="(max-width: 768px) 100vw, 55vw"
          class="ratio-4-5"
          loading="eager"
        />
      </div>
      {piece.gallery.map((g) => (
        'placeholder' in g
          ? <div class="placeholder ratio-4-5">{g.placeholder}</div>
          : <div class="frame"><Image src={g.src} alt={g.alt} widths={[480, 768, 1100]} sizes="(max-width: 768px) 100vw, 55vw" class="ratio-4-5" loading="lazy" /></div>
      ))}
    </div>

    <!-- Detail rail -->
    <aside class="piece__rail">
      <p class="piece__capsule">{capsule.name.toUpperCase()} · {capsule.number}</p>
      <h1 class="piece__name">{piece.name}</h1>
      <p class="piece__spec">{piece.spec}</p>

      <div class="piece__price-row">
        <span class="piece__price">{piece.price}</span>
        <span class="piece__lead">{piece.leadTimeWeeks} weeks</span>
      </div>

      <div class="piece__desc">
        {piece.description.map((d) => (<p class="body-sm">{d}</p>))}
      </div>

      <dl class="piece__details">
        {details.map(([label, value]) => (
          <div class="piece__detail-row">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>

      <Button href={`/commissions?piece=${piece.slug}`} variant="primary" class="piece__cta">
        Enquire about this piece
      </Button>
      <p class="piece__note">Each piece is made to order. Pattern and timber can be chosen with you.</p>
    </aside>
  </div>

  {others.length > 0 && (
    <section class="section page-pad piece__others">
      <h2 class="h2 piece__others-head reveal">Other pieces in {capsule.name}</h2>
      <div class="piece__others-grid">
        {others.map((p) => (<ProductCard piece={p} />))}
      </div>
    </section>
  )}
</Base>

<style>
  .piece {
    display: grid;
    grid-template-columns: 60% 40%;
    gap: 0;
    padding-top: 48px;
    padding-bottom: 96px;
  }
  .piece__gallery { display: flex; flex-direction: column; gap: 12px; }

  .piece__rail {
    position: sticky;
    top: 100px;
    align-self: start;
    padding-left: 56px;
  }
  .piece__capsule {
    font-family: var(--mono); font-weight: 300; font-size: 10px;
    letter-spacing: .14em; text-transform: uppercase; color: var(--label);
  }
  .piece__name {
    font-family: var(--serif); font-weight: 300; font-size: 44px;
    line-height: 1.05; color: var(--ink); margin: 14px 0 0;
  }
  .piece__spec {
    font-family: var(--mono); font-weight: 300; font-size: 10px;
    letter-spacing: .12em; text-transform: uppercase; color: #8C8577; margin-top: 10px;
  }
  .piece__price-row {
    display: flex; align-items: baseline; gap: 20px;
    margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--bone-light);
  }
  .piece__price { font-family: var(--serif); font-weight: 400; font-size: 22px; color: var(--ink); }
  .piece__lead {
    font-family: var(--sans); font-weight: 400; font-size: 10.5px;
    letter-spacing: .16em; text-transform: uppercase; color: var(--gold-text);
  }
  .piece__desc { margin-top: 22px; }
  .piece__desc .body-sm + .body-sm { margin-top: 14px; }

  .piece__details { margin: 26px 0 0; }
  .piece__detail-row {
    display: flex; justify-content: space-between; align-items: baseline; gap: 20px;
    padding: 14px 0; border-top: 1px solid var(--bone-light);
  }
  .piece__detail-row:last-child { border-bottom: 1px solid var(--bone-light); }
  .piece__detail-row dt {
    font-family: var(--mono); font-size: 10px; letter-spacing: .04em;
    text-transform: uppercase; color: #8C8577;
  }
  .piece__detail-row dd {
    margin: 0; text-align: right;
    font-family: var(--sans); font-weight: 300; font-size: 14px; color: var(--ink);
  }

  .piece__cta { margin-top: 28px; }
  .piece__note {
    font-family: var(--sans); font-weight: 300; font-size: 13px;
    color: #6F6A5D; margin-top: 14px; max-width: 40ch;
  }

  .piece__others-head { margin-bottom: 40px; }
  .piece__others-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }

  @media (max-width: 768px) {
    .piece { grid-template-columns: 1fr; padding-top: 24px; }
    .piece__rail { position: static; padding-left: 0; margin-top: 40px; }
  }
</style>
