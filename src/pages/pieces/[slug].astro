---
export const prerender = true;
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import ProductCard from '../../components/ProductCard.astro';
import {
  pieces,
  pieceBySlug,
  capsuleBySlug,
  otherPiecesInCapsule,
} from '../../data/content';
import { site, whatsappLink } from '../../data/site';

export function getStaticPaths() {
  return pieces.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const piece = pieceBySlug(slug!)!;
const capsule = capsuleBySlug(piece.capsule)!;
const others = otherPiecesInCapsule(piece.capsule, piece.slug);
const waHref = whatsappLink(`Hello Patterns + Patina — I'm interested in ${piece.name} (${capsule.name}, ${piece.number}).`);
---
<Base title={piece.name} description={`${piece.tagline} ${piece.description[0]} ${piece.price}.`} image={piece.hero.src}>
  <div class="piece page-pad">
    <!-- Photograph -->
    <div class="piece__gallery">
      <div class="frame">
        <Image
          src={piece.hero.src}
          alt={piece.hero.alt}
          widths={[640, 960, 1280, 1800]}
          sizes="(max-width: 768px) 100vw, 60vw"
          quality={90}
          loading="eager"
        />
      </div>
    </div>

    <!-- Detail rail -->
    <aside class="piece__rail">
      <p class="piece__capsule">{capsule.name.toUpperCase()} · {capsule.number}</p>
      <p class="piece__num">{piece.number}</p>
      <h1 class="piece__name">{piece.name}</h1>
      <p class="piece__spec">{piece.spec}</p>
      <p class="piece__tagline">{piece.tagline}</p>

      <div class="piece__desc">
        {piece.description.map((d) => (<p class="body-sm">{d}</p>))}
      </div>

      <div class="piece__price-row">
        <span class="piece__price">{piece.price}</span>
        {piece.availability && <span class="piece__lead">{piece.availability}</span>}
      </div>

      <div class="piece__notes">
        {piece.notes.map((n) => (<p>{n}</p>))}
      </div>

      <Button href={waHref} variant="primary" class="piece__cta">
        WhatsApp “{piece.name}”
      </Button>
      <p class="piece__note">
        To purchase or arrange a private viewing in Nairobi. WhatsApp {site.whatsappDisplay}, or
        <a href={`/commissions?piece=${piece.slug}`}>send an enquiry</a>.
      </p>
    </aside>
  </div>

  {others.length > 0 && (
    <section class="section page-pad piece__others">
      <h2 class="h2 piece__others-head reveal">More from {capsule.name}</h2>
      <div class="piece__others-grid">
        {others.map((p) => (<ProductCard piece={p} />))}
      </div>
    </section>
  )}
</Base>

<style>
  .piece {
    display: grid;
    grid-template-columns: 60% 40%;
    gap: 0;
    padding-top: 48px;
    padding-bottom: 96px;
  }
  .piece__gallery { display: flex; flex-direction: column; gap: 12px; }

  .piece__rail {
    position: sticky;
    top: 100px;
    align-self: start;
    padding-left: 56px;
  }
  .piece__capsule {
    font-family: var(--mono); font-weight: 300; font-size: 10px;
    letter-spacing: .14em; text-transform: uppercase; color: var(--label);
  }
  .piece__name {
    font-family: var(--serif); font-weight: 300; font-size: 44px;
    line-height: 1.05; color: var(--ink); margin: 14px 0 0;
  }
  .piece__spec {
    font-family: var(--mono); font-weight: 300; font-size: 10px;
    letter-spacing: .12em; text-transform: uppercase; color: #8C8577; margin-top: 10px;
  }
  .piece__price-row {
    display: flex; align-items: baseline; gap: 20px;
    margin-top: 26px; padding-top: 18px; border-top: 1px solid var(--bone-light);
  }
  .piece__price { font-family: var(--serif); font-weight: 400; font-size: 22px; color: var(--ink); }
  .piece__lead {
    font-family: var(--sans); font-weight: 400; font-size: 10.5px;
    letter-spacing: .16em; text-transform: uppercase; color: var(--gold-text);
  }
  .piece__num {
    font-family: var(--serif); font-weight: 300; font-size: 18px;
    color: var(--gold-text); margin-top: 22px;
  }
  .piece__gallery :global(img) { width: 100%; height: auto; display: block; }
  .piece__tagline {
    font-family: var(--serif); font-style: italic; font-weight: 300;
    font-size: 24px; line-height: 1.3; color: var(--olive-story); margin-top: 22px;
  }
  .piece__notes { margin-top: 18px; }
  .piece__notes p {
    font-family: var(--sans); font-weight: 300; font-size: 14px; color: var(--ink-soft);
  }
  .piece__note a { color: var(--gold-text); text-decoration: underline; text-underline-offset: 3px; }
  .piece__desc { margin-top: 22px; }
  .piece__desc .body-sm + .body-sm { margin-top: 14px; }


  .piece__cta { margin-top: 28px; }
  .piece__note {
    font-family: var(--sans); font-weight: 300; font-size: 13px;
    color: #6F6A5D; margin-top: 14px; max-width: 40ch;
  }

  .piece__others-head { margin-bottom: 40px; }
  .piece__others-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  @media (max-width: 768px) {
    .piece { grid-template-columns: 1fr; padding-top: 24px; }
    .piece__rail { position: static; padding-left: 0; margin-top: 40px; }
  }
</style>
