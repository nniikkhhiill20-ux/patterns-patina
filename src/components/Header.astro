---
import { Image } from 'astro:assets';
import Wordmark from './Wordmark.astro';
import { navLinks } from '../data/site';
import crest from '../assets/logo/pp-crest.png';
---
<header class="site-header" id="siteHeader">
  <a class="site-header__brand" href="/" aria-label="Patterns + Patina — home">
    <Wordmark size={14} />
  </a>

  <nav class="site-header__nav" aria-label="Primary">
    {navLinks.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
  </nav>

  <button class="site-header__burger" id="navBurger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
    <span></span><span></span><span></span>
  </button>
</header>

<div class="mobile-nav" id="mobileNav" hidden>
  <button class="mobile-nav__close" id="navClose" aria-label="Close menu">
    <span></span><span></span>
  </button>
  <Image src={crest} alt="" width={120} height={120} class="mobile-nav__crest" densities={[1, 2]} />
  <nav aria-label="Primary mobile">
    {navLinks.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
  </nav>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 18px 72px;
    background: var(--warm-paper);
    border-bottom: 1px solid var(--bone);
    transition: background 200ms ease;
  }
  /* Sticky translucency once scrolled */
  .site-header.is-stuck {
    background: rgba(250, 247, 236, .92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .site-header__nav {
    display: flex;
    gap: 26px;
  }
  .site-header__nav a {
    font-family: var(--sans);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: #4A463D;
    transition: color 200ms ease;
  }
  @media (hover: hover) {
    .site-header__nav a:hover { color: var(--gold-text); }
  }

  .site-header__burger, .mobile-nav__close {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }
  .site-header__burger span {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--ink);
    margin: 6px 0;
  }

  @media (max-width: 768px) {
    .site-header { padding: 14px 20px; }
    .site-header__nav { display: none; }
    .site-header__burger { display: block; }
  }

  /* ---- Full-screen mobile overlay ---- */
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--warm-paper);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .mobile-nav[hidden] { display: none; }
  .mobile-nav__crest { width: 120px; height: auto; margin-bottom: 24px; }
  .mobile-nav nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .mobile-nav nav a {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 28px;
    color: var(--ink);
  }
  .mobile-nav__close {
    display: block;
    position: absolute;
    top: 18px;
    right: 20px;
    width: 34px;
    height: 34px;
  }
  .mobile-nav__close span {
    position: absolute;
    top: 50%;
    left: 4px;
    width: 26px;
    height: 1px;
    background: var(--ink);
  }
  .mobile-nav__close span:nth-child(1) { transform: rotate(45deg); }
  .mobile-nav__close span:nth-child(2) { transform: rotate(-45deg); }
</style>

<script>
  const header = document.getElementById('siteHeader');
  const burger = document.getElementById('navBurger');
  const closeBtn = document.getElementById('navClose');
  const menu = document.getElementById('mobileNav');

  // Sticky translucency
  if (header) {
    const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const setOpen = (open: boolean) => {
    if (!menu || !burger) return;
    menu.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };

  burger?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>
