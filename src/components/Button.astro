---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'tertiary' | 'inverted';
  type?: 'button' | 'submit';
  class?: string;
}
const { href, variant = 'primary', type = 'button', class: cls = '' } = Astro.props;
const classes = `btn btn--${variant} ${cls}`;
const external = href?.startsWith('http');
---
{href ? (
  <a href={href} class={classes} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}><slot /></a>
) : (
  <button type={type} class={classes}><slot /></button>
)}
