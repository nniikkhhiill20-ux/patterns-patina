---
import { Image } from 'astro:assets';
import type { Piece } from '../data/content';
interface Props { piece: Piece; }
const { piece } = Astro.props;
---
<a class="card reveal" href={`/pieces/${piece.slug}`}>
  <div class="card__img frame frame--zoom">
    <Image
      src={piece.hero.src}
      alt={piece.hero.alt}
      widths={[400, 640, 900, 1200]}
      sizes="(max-width: 768px) 100vw, 30vw"
      quality={90}
      class="ratio-4-5"
      loading="lazy"
    />
  </div>
  <div class="card__body">
    <p class="card__num">{piece.number}</p>
    <h3 class="h3 card__name">{piece.name}</h3>
    <p class="card__spec">{piece.spec}</p>
    <p class="card__tagline">{piece.tagline}</p>
    <div class="card__meta">
      <span class="card__price">{piece.price}</span>
      {piece.availability && <span class="card__lead">{piece.availability}</span>}
    </div>
  </div>
</a>

<style>
  .card {
    display: block;
    background: var(--warm-paper);
    border: 1px solid var(--bone);
    transition: border-color 300ms ease;
  }
  @media (hover: hover) { .card:hover { border-color: #D8CFAE; } }

  .card__img { width: 100%; }
  .card__img :global(img) { width: 100%; display: block; }

  .card__body { padding: 20px 22px 24px; }
  .card__num {
    font-family: var(--mono);
    font-weight: 300;
    font-size: 10px;
    letter-spacing: .12em;
    color: var(--gold-text);
    margin-bottom: 6px;
  }
  .card__name { color: var(--ink); }
  .card__tagline {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 16px;
    color: var(--olive-story);
    margin-top: 10px;
  }
  .card__spec {
    font-family: var(--mono);
    font-weight: 300;
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 8px;
  }
  .card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--bone-light);
  }
  .card__meta { flex-wrap: wrap; gap: 6px 12px; }
  .card__price { font-family: var(--serif); font-weight: 400; font-size: 19px; color: var(--ink); white-space: nowrap; }
  .card__lead {
    font-family: var(--sans);
    font-weight: 400;
    font-size: 10.5px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--gold-text);
    white-space: nowrap;
  }
</style>
